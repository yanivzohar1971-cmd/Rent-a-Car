{
  "name": "rentacar-functions",
  "version": "1.0.1",
  "description": "Cloud Functions for Rent_a_Car app",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "smoke:sitemap-cars": "node scripts/smoke-sitemap-cars.mjs",
    "smoke:sitemap-cars:verbose": "node scripts/smoke-sitemap-cars.mjs --verbose",
    "prod:seo:verify": "node scripts/prod-seo-verify.mjs",
    "probe:publiccars": "node scripts/firestore-publiccars-probe.mjs"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
