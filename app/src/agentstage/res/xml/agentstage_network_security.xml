<?xml version="1.0" encoding="utf-8"?>
<!--
  agentstage only. The emulator reaches the Windows host as 10.0.2.2:
   - Firebase Auth/Firestore emulators speak plain HTTP (local only)  -> cleartext allowed for 10.0.2.2
   - the dev relay speaks HTTPS with a locally generated certificate -> trusted for 10.0.2.2 only
  Everything else keeps the platform defaults (no cleartext, system CAs).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <trust-anchors>
            <certificates src="@raw/agentstage_relay_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
