# Storage
BRIDGE_DATA_FILE=./data/bridge.json

# HTTP transport (for remote MCP clients / tunnel)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Optional bearer protection for HTTP.
# Recommended whenever the endpoint is reachable beyond localhost.
BRIDGE_AUTH_TOKEN=replace-with-a-long-random-secret

# DANGEROUS: only for an isolated test tunnel when no authentication is possible.
# BRIDGE_ALLOW_UNAUTHENTICATED_REMOTE=true

# Optional Firebase HTTPS relay (ChatGPT -> Cloud Function -> this local process).
# Do not commit real tokens. Copy this file to .env locally.
YZ_BRIDGE_FIREBASE_API_URL=https://us-central1-carexpert-94faa.cloudfunctions.net/yzBridgeApi
YZ_BRIDGE_API_TOKEN=replace-with-the-same-token-configured-in-firebase
YZ_BRIDGE_AGENT_ID=yaniv-cursor
YZ_BRIDGE_PROJECT=Rent_a_Car
YZ_BRIDGE_CHATGPT_KEY=replace-with-chatgpt-get-key-not-the-bearer-token
YZ_BRIDGE_RELAY_INTERVAL_MS=15000

# GitHub inbox transport (ChatGPT -> GitHub Issue -> local github-relay)
YZ_BRIDGE_GITHUB_REPO=yanivzohar1971-cmd/Rent-a-Car
YZ_BRIDGE_GITHUB_POLL_INTERVAL_MS=15000
YZ_BRIDGE_AGENT_AUTO_LAUNCH=true
YZ_BRIDGE_AGENT_WINDOW_KEEP_OPEN=false
YZ_BRIDGE_WORKSPACE=C:\Users\Yaniv\source\repos\Rent_a_Car
# Optional only if gh / git credentials are unavailable:
# YZ_BRIDGE_GITHUB_TOKEN=

# ChatGPT GET modes: INLINE /chatgpt/enqueue and CHUNKS /chatgpt/chunks/*
# See docs/FIREBASE-RELAY.md for URL templates with placeholders.
# Optional temporary session capability (gitignored .env / Secret Manager only; never commit a real value):
# YZ_BRIDGE_CHATGPT_SESSION_KEY=
# YZ_BRIDGE_CHATGPT_SESSION_EXPIRES_AT=
